<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.bitaron</groupId>
        <artifactId>audit-log</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>audit-log-spring-boot-starter</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <packaging>jar</packaging>
    <description>Starter for the audit-log Spring Boot library: records audit trail entries for @Audit-annotated methods. This is the artifact applications should depend on.</description>
    <url>https://github.com/Bitaron/spring-boot-activity-log</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Bitaron</id>
            <name>Sk. Kamruzzaman</name>
            <email>bitaron90@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/Bitaron/spring-boot-activity-log</connection>
        <developerConnection>scm:git:ssh://github.com:Bitaron/spring-boot-activity-log.git</developerConnection>
        <url>https://github.com/Bitaron/spring-boot-activity-log</url>
    </scm>

    <distributionManagement>
        <snapshotRepository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
        </snapshotRepository>
        <repository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>
        </repository>
    </distributionManagement>

    <!--
        No src/ - this is a pure dependency-descriptor module, following the same pattern as
        Spring Boot's own spring-boot-starter-* artifacts: the starter's only job is to declare
        "what a consumer needs on the classpath", so the actual code lives in the
        -autoconfigure module and can be depended on separately if ever needed.
    -->
    <dependencies>
        <dependency>
            <groupId>io.github.bitaron</groupId>
            <artifactId>audit-log-spring-boot-autoconfigure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- AOP is what actually intercepts @Audit methods; a consumer of the starter needs it
             at compile+runtime, so it is a real (non-provided) dependency here. Boot 4 renamed
             spring-boot-starter-aop to spring-boot-starter-aspectj (same spring-aop + aspectjweaver
             contents, proxy-based Spring AOP - not full AspectJ compile/load-time weaving; verified
             against the artifact's own published pom). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
    </dependencies>

    <!--
        Signing and publishing to Central require a GPG key and Sonatype credentials that most
        contributors and CI builds don't have. maven-gpg-plugin only runs when this profile is
        explicitly requested (e.g. "mvn -P release deploy").
    -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <keyname>08D54EE8</keyname>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
