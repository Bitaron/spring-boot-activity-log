<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.bitaron</groupId>
        <artifactId>spring-boot-activity-log-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>audit-log</artifactId>
    <packaging>pom</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Aggregator for the audit-log autoconfigure module and its dependency-only starter pom.</description>

    <!--
        Two modules, following the standard third-party Spring Boot starter split
        (cf. spring-boot-starter-* / spring-boot-autoconfigure convention):
          - audit-log-spring-boot-autoconfigure: all the actual code.
          - audit-log-spring-boot-starter: a pom-only module consumers depend on, pulling in the
            autoconfigure module plus the runtime dependencies (AOP) it needs to function.
        This lets a consumer swap the autoconfigure module out (e.g. for a customized fork) while
        keeping the starter's transitive dependency set, and matches how spring-boot-starter-*
        modules are themselves structured.
    -->
    <modules>
        <module>audit-log-spring-boot-autoconfigure</module>
        <module>audit-log-spring-boot-starter</module>
    </modules>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Bitaron</id>
            <name>Sk. Kamruzzaman</name>
            <email>bitaron90@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/Bitaron/spring-boot-activity-log</connection>
        <developerConnection>scm:git:ssh://github.com:Bitaron/spring-boot-activity-log.git</developerConnection>
        <url>https://github.com/Bitaron/spring-boot-activity-log</url>
    </scm>

    <distributionManagement>
        <snapshotRepository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
        </snapshotRepository>
        <repository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>
        </repository>
    </distributionManagement>

</project>
